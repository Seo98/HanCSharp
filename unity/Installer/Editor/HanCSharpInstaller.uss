.han-install { padding: 10px; }
.han-install-status { white-space: normal; margin-top: 8px; margin-bottom: 8px; }
.han-install-actions { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.han-install-actions Button { margin: 3px; min-height: 24px; padding-left: 8px; padding-right: 8px; }
#applyUpdate { min-height: 28px; margin-top: 8px; }
.han-install-details { flex-grow: 1; margin-top: 8px; }
.han-install-details .unity-text-field__input { white-space: pre; -unity-text-align: upper-left; }
