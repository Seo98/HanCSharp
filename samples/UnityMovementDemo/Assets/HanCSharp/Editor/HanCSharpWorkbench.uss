.han-workbench { flex-grow: 1; padding: 8px; }
.han-path { white-space: normal; margin-bottom: 6px; }
.han-toolbar { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.han-status { white-space: normal; margin-bottom: 8px; }
.han-panes { flex-grow: 1; }
.han-split { flex-grow: 1; }
.han-pane { flex-grow: 1; min-width: 120px; }
.han-heading { margin: 5px; -unity-font-style: bold; }
.han-scroll { flex-grow: 1; }
.han-code { flex-grow: 1; }
.han-code .unity-text-field__input { white-space: pre; -unity-text-align: upper-left; }
.han-diagnostics { max-height: 120px; flex-shrink: 0; }
.han-diagnostic { white-space: normal; -unity-text-align: middle-left; }
